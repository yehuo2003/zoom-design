{
  "name": "@zoom-design/angular-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "Private native Angular engineering host",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/run-local-bin.mjs --workspace . --package @angular/cli --bin ng -- build angular-smoke --configuration production",
    "dev": "node ../../scripts/run-local-bin.mjs --workspace . --package @angular/cli --bin ng -- serve angular-smoke --host 127.0.0.1 --port 5173",
    "typecheck": "node ../../scripts/run-local-bin.mjs --workspace . --package @angular/compiler-cli --bin ngc -- -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@zoom-design/angular": "0.0.0",
    "@angular/core": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/cli": "22.2.5",
    "@angular/build": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "typescript": "6.0.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
