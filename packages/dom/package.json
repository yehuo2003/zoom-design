{
  "name": "@zoom-design/dom",
  "version": "0.0.0",
  "description": "Framework-neutral browser interaction utilities",
  "private": false,
  "author": "linzhuming",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zoom-design/core": "0.0.0",
    "@floating-ui/dom": "1.8.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-platform.mjs dom",
    "typecheck": "node ../../scripts/typecheck-platform.mjs dom",
    "test:unit": "node ../../scripts/test-unit.mjs --standalone --package dom",
    "test:coverage": "node ../../scripts/test-unit.mjs --standalone --coverage --package dom",
    "test:e2e": "node ../../scripts/e2e.mjs --mode workspace --package dom --browser chromium"
  }
}
