{
  "name": "@zoom-design/angular",
  "version": "0.0.0",
  "description": "Angular components for Zoom Design",
  "private": false,
  "author": "linzhuming",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./style.css": "./styles/style.css",
    "./theme.css": "./styles/theme.css",
    "./theme.scss": {
      "sass": "./styles/theme/_index.scss",
      "default": "./styles/theme/_index.scss"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-angular.mjs",
    "typecheck": "node ../../scripts/check-angular.mjs",
    "test:unit": "node ../../scripts/test-angular.mjs",
    "test:list": "node ../../scripts/test-angular.mjs --list-tests",
    "test:coverage": "node ../../scripts/test-unit.mjs --standalone --coverage --package angular",
    "test:e2e": "node ../../scripts/e2e.mjs --mode workspace --browser chromium --package angular"
  },
  "devDependencies": {
    "vitest": "5.0.5",
    "jsdom": "30.1.3",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "@angular/core": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/cli": "22.2.5",
    "@angular/build": "22.2.5",
    "@angular/ssr": "22.2.5",
    "ng-packagr": "22.2.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "peerDependencies": {
    "@angular/core": "~22.2.3",
    "@angular/common": "~22.2.3",
    "rxjs": "~7.8.2",
    "tslib": "~2.8.1"
  }
}
