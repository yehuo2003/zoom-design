{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["test/fixtures/negative.tsx", "test/fixtures/consumer.tsx"]
}
