{
  "name": "@zoom-design/vue",
  "version": "0.0.0",
  "description": "Vue components for Zoom Design",
  "private": false,
  "author": "linzhuming",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/types/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./button/style.css": "./dist/button/style.css",
    "./select": {
      "types": "./dist/types/select/index.d.ts",
      "import": "./dist/select/index.js"
    },
    "./select/style.css": "./dist/select/style.css",
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/theme.css",
    "./theme.scss": {
      "sass": "./dist/styles/theme/_index.scss",
      "default": "./dist/styles/theme/_index.scss"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-framework.mjs vue",
    "typecheck": "node ../../scripts/check-vue.mjs",
    "test:unit": "node ../../scripts/test-unit.mjs --standalone --package vue",
    "test:e2e": "node ../../scripts/e2e.mjs --mode workspace --package vue --browser chromium",
    "test:coverage": "node ../../scripts/test-unit.mjs --standalone --coverage --package vue"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vue": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/compiler-dom": "3.5.44",
    "@vue/server-renderer": "3.5.44",
    "vue-tsc": "3.3.13",
    "vite": "8.3.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "peerDependencies": {
    "vue": "~3.5.44"
  },
  "dependencies": {
    "@zoom-design/core": "0.0.0",
    "@zoom-design/dom": "0.0.0"
  }
}
