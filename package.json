{
  "name": "zoom-design",
  "version": "0.0.0",
  "description": "Zoom Design multi-framework component library workspace",
  "workspaces": [
    "packages/core",
    "packages/dom",
    "packages/vue",
    "packages/react",
    "packages/angular",
    "apps/*"
  ],
  "private": true,
  "devDependencies": {
    "typescript": "7.0.2",
    "sass": "1.106.1",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@playwright/test": "1.64.1",
    "jsdom": "30.1.3",
    "@types/node": "26.6.5",
    "semver": "7.8.5",
    "vite": "8.3.5"
  },
  "volta": {
    "node": "26.12.1",
    "npm": "12.2.1"
  },
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=26.12.1 <27",
    "npm": ">=12.2.1 <13"
  },
  "scripts": {
    "build": "node scripts/workspace.mjs build",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "test:unit": "node scripts/workspace.mjs unit",
    "test:coverage": "node scripts/workspace.mjs coverage",
    "check": "node scripts/check.mjs",
    "ci:verify": "node scripts/ci.mjs",
    "verify:quality": "node tests/engineering/verify-quality.mjs",
    "verify:ci:portable": "node tests/engineering/portable-ci.mjs",
    "test:e2e": "node scripts/e2e.mjs --mode workspace",
    "test:e2e:all": "node scripts/e2e.mjs --mode workspace --browser all",
    "check:versions": "node scripts/check-toolchain.mjs",
    "test:engineering": "vitest run --config tests/engineering/vitest.config.ts",
    "verify:portable": "node tests/engineering/portable-install.mjs",
    "check:platform": "node scripts/check-platform.mjs",
    "test:e2e:platform": "node scripts/e2e.mjs --mode workspace --package platform --browser chromium",
    "dev:platform": "node scripts/dev.mjs --app platform",
    "dev:vue": "node scripts/dev.mjs --app vue",
    "dev:react": "node scripts/dev.mjs --app react",
    "dev:angular": "node scripts/dev.mjs --app angular",
    "test:e2e:workspace": "node scripts/e2e.mjs --mode workspace --browser chromium",
    "check:pack": "node scripts/pack-smoke.mjs",
    "test:e2e:packed": "node scripts/e2e-packed.mjs"
  }
}
